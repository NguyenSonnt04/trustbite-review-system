{
  "name": "trustbite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run client:dev\" \"npm run server:dev\"",
    "client:dev": "npm run dev --prefix client",
    "server:dev": "npm run dev --prefix server",
    "client:build": "npm run build --prefix client",
    "server:build": "npm run build --prefix server",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "harness": "node scripts/harness.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
