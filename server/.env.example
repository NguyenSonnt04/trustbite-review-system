# ========================================
# TRUSTBITE SERVER - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in values
# ========================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=trustbite_user
DATABASE_PASSWORD=your-local-db-password
DATABASE_NAME=trustbite_db
DATABASE_SSL=false
# Set false only for non-production paths that must skip certificate verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# AWS General
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS S3 - Customer receipt and private merchant claim evidence storage
AWS_S3_BUCKET_NAME=trustbite-invoices
TRUSTBITE_MERCHANT_CLAIM_SIGNED_URL_TTL_SECONDS=900

# Private AWS S3 restaurant profile images, delivered through short-lived signed GET URLs
AWS_RESTAURANT_IMAGES_BUCKET_NAME=trustbite-restaurant-images
TRUSTBITE_RESTAURANT_IMAGE_SIGNED_URL_TTL_SECONDS=900

# AWS SES - Email / OTP notifications
AWS_SES_SENDER_EMAIL=noreply@trustbite.com

# AWS Cognito - User authentication
AWS_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
AWS_COGNITO_CLIENT_ID=your-cognito-app-client-id
# Dedicated confidential app client for the admin web BFF. Enable
# ALLOW_USER_PASSWORD_AUTH, token revocation, and PreventUserExistenceErrors.
AWS_COGNITO_ADMIN_WEB_CLIENT_ID=your-admin-web-app-client-id
AWS_COGNITO_ADMIN_WEB_CLIENT_SECRET=your-admin-web-app-client-secret
# Defaults on only in local development/test. Production-like environments must
# explicitly opt in after verified-phone backfill dry-run/bind proof.
# AUTH_PHONE_FALLBACK_ENABLED=false

# TrustBite-owned avatar URL origins accepted by PATCH /api/v1/users/me
TRUSTBITE_AVATAR_ALLOWED_HOSTS=cdn.trustbite.test

# In-app notification creation. Defaults on outside production and off in production.
TRUSTBITE_NOTIFICATIONS_ENABLED=true

# AWS Bedrock - AI Review Summarization
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS Location Service - map rendering, place search, and routing
AWS_LOCATION_MAP_NAME=TrustBiteMap
AWS_LOCATION_PLACE_INDEX_NAME=TrustBitePlaceIndex
AWS_LOCATION_ROUTE_CALCULATOR_NAME=TrustBiteRouteCalculator
# Optional local credentials dedicated to Location. When omitted, the SDK uses
# shared AWS credentials or the deployment role credential chain.
AWS_LOCATION_ACCESS_KEY_ID=
AWS_LOCATION_SECRET_ACCESS_KEY=
AWS_LOCATION_SESSION_TOKEN=
# Public mobile map key; keep blank in source and restrict it to the map/action,
# intended apps/origins, and usage quotas in AWS.
AWS_LOCATION_MAP_API_KEY=
# Shared per-IP budget for paid place/reverse/route backend operations.
AWS_LOCATION_RATE_LIMIT_MAX=60
AWS_LOCATION_RATE_LIMIT_WINDOW_SECONDS=60

# Redis - OTP rate limits and OCR job queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Admin web BFF and fixed-lifetime opaque session
# Use independent cryptographically random values and keep them server-only.
ADMIN_WEB_BFF_SECRET=replace-with-random-bff-secret
ADMIN_WEB_SESSION_KEY_SECRET=replace-with-random-session-key-secret
ADMIN_WEB_SESSION_MAX_SECONDS=900
ADMIN_LOGIN_RATE_LIMIT_MAX=5
ADMIN_LOGIN_EMAIL_RATE_LIMIT_MAX=20
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Receipt OCR pipeline
# OCR_PROVIDER: 'textract' (real) or 'mock' (test/local only; fails closed elsewhere)
OCR_PROVIDER=mock
OCR_QUEUE_NAME=receipt-ocr
OCR_JOB_ATTEMPTS=3
OCR_JOB_BACKOFF_MS=5000
OCR_JOB_TIMEOUT_MS=30000
# Upload guards applied before OCR
OCR_MAX_FILE_BYTES=10485760
OCR_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,heic

# CORS
ALLOWED_ORIGINS=http://localhost:3000
