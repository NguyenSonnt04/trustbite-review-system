# ========================================
# TRUSTBITE SERVER - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in values
# ========================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=trustbite_user
DATABASE_PASSWORD=your-local-db-password
DATABASE_NAME=trustbite_db

# AWS General
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 - Invoice image storage
AWS_S3_BUCKET_NAME=trustbite-invoices

# AWS SES - Email / OTP notifications
AWS_SES_SENDER_EMAIL=noreply@trustbite.com

# AWS Cognito - User authentication
AWS_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
AWS_COGNITO_CLIENT_ID=your-cognito-app-client-id

# AWS Bedrock - AI Review Summarization
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# CORS
ALLOWED_ORIGINS=http://localhost:3000
