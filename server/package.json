{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node scripts/check-syntax.mjs",
    "db:migrate": "node scripts/migrate.js",
    "cognito:configure-admin-web": "node scripts/configure-admin-cognito-client.mjs",
    "deletions:process": "node scripts/process-deletions.mjs",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --no-file-parallelism tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/client-textract": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "bullmq": "5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "5.11.1",
    "multer": "^2.2.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
