NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id

# Server-only Next.js BFF configuration. Never use a NEXT_PUBLIC_ prefix.
TRUSTBITE_SERVER_API_URL=http://localhost:5000
ADMIN_WEB_BFF_SECRET=replace-with-the-same-random-value-as-the-server
# Required in production. The named header must be overwritten by a trusted
# reverse proxy and contain the original client IP as its first value.
ADMIN_WEB_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
