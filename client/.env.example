NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id

# Local development only. Both values are required before the browser sends
# the trusted development identity header.
NEXT_PUBLIC_TRUSTBITE_TRUSTED_AUTH_HEADERS=false
NEXT_PUBLIC_TRUSTBITE_DEV_USER_ID=

# Server-only Next.js BFF configuration. Never use a NEXT_PUBLIC_ prefix.
TRUSTBITE_SERVER_API_URL=http://localhost:5000
ADMIN_WEB_BFF_SECRET=replace-with-the-same-random-value-as-the-server
# Required in production. The trusted proxy must replace this header with one
# client IP; comma-separated/forwarded chains are rejected.
# nginx: proxy_set_header X-Forwarded-For $remote_addr;
# Caddy: header_up X-Forwarded-For {remote_host}
ADMIN_WEB_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
